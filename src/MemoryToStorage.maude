*** SIBLING NOTE: SolKey's structMemoryRules.key gained selectOnCopyMemRef,
*** so a memory->storage copy is readable one selector at a time under the new
*** non-collapsing save leaf:
***   selectSt<[Struct]>(copyMem(st,mem,id), a) = copyMem(mtSt, mem, read<[Identity]>(mem,id,a))
*** The Maude analogue is in src/sem/Stmt.maude, next to the copyMem equations
*** restated there. It is not needed in THIS file: reads here are whole-path,
*** and find(find(st,p),q) = find(st, p q) re-flattens the stuck subterm so the
*** primitive rule below fires. Recorded so the two stay comparable.

load Memory .
load Storage .

fmod MemoryToStorage{Field :: TRIV} is
    pr BANK-ERASE{Field} .
    pr STORAGE{Field} .

    var st : Value .
    var pF : PrimField .
    var fld : Field$Elt .
    var idF : RefField .
    var vSt : Struct .
    var vInt : Int .
    var id id2 : Identity .
    var mem : Memory .
    var fxs : List{Field} .

    op copyMem : Struct Memory Identity -> Struct .

    eq find(copyMem(st, mem, id), fxs pF) = readR(mem, id, fxs pF) .
endfm


fmod Examples{Field :: TRIV} is
    pr MemoryToStorage{Field} .

    ops $alice $bob $carol $account : -> RefField .
    ops $balance : -> PrimField .
    ops st1 stAlice stBal : -> Struct .
    ops idA idF : -> IdentityPrim .
    ops mem nMem memAlice : -> Memory .

    eq nMem = write(addM(mem, idA), idC(idA, $account), $balance, 10) .
    eq stAlice = copyMem(st1, nMem, idC(idA, nil)) .
endfm

red find(find(stAlice, $account), $balance) .
red find(stAlice, $account $balance) .
