*** StorageCanonical.maude -- helper-free lazy storage updates.
***
*** Structs are write histories.  Mappings and arrays wrap histories so their
*** runtime identity is visible without a field declaration environment.
*** save and delete are themselves pending storage mutations: select/find
*** interpret them one selector at a time.  Exact aggregate observations keep
*** those terms suspended.  An explicit MapStruct source has deliberately no
*** copy equation, so observing a direct or nested mapping copy stays stuck.
***
*** Type arguments provide zero values only.  The frontend remains responsible
*** for rejecting mapping-containing assignments when an empty runtime value
*** contains no MapStruct marker with which this model could detect them.

fmod GENERIC-STORAGE-VALUES is
  pr INT .

  sorts StValue Struct MapStruct Array Field LengthField Type .
  subsort Int Struct MapStruct Array < StValue .
  subsort Int LengthField < Field .

  op length : -> LengthField [ctor] .
  ops intT structT : -> Type [ctor] .
  op mapT : Type -> Type [ctor] .
  op arrayT : Type -> Type [ctor] .

  op mtst : -> Struct [ctor] .
  op store : Struct Field StValue -> Struct [ctor] .
  op map : Struct -> MapStruct [ctor] .
  op array : Struct -> Array [ctor] .

  op def : Type -> StValue .
  var T : Type .
  eq def(intT) = 0 .
  eq def(structT) = mtst .
  eq def(mapT(T)) = map(mtst) .
  eq def(arrayT(T)) = array(store(mtst,length,0)) .
endfm

view Field from TRIV to GENERIC-STORAGE-VALUES is sort Elt to Field . endv

fmod GENERIC-STORAGE is
  pr GENERIC-STORAGE-VALUES .
  pr LIST{Field} .

  *** These are the complete public operations.  The more specific overloads
  *** retain the container sort while a mutation is suspended.
  op select : Type StValue Field -> [StValue] .
  op find : Type StValue List{Field} -> [StValue] .
  op save : StValue List{Field} StValue -> [StValue] [ctor] .
  op save : Struct List{Field} StValue -> Struct [ctor ditto] .
  op save : MapStruct List{Field} StValue -> MapStruct [ctor ditto] .
  op save : Array List{Field} StValue -> Array [ctor ditto] .
  op delete : Type StValue List{Field} -> [StValue] [ctor] .
  op delete : Type Struct List{Field} -> Struct [ctor ditto] .
  op delete : Type MapStruct List{Field} -> MapStruct [ctor ditto] .
  op delete : Type Array List{Field} -> Array [ctor ditto] .
  op push : StValue List{Field} StValue -> [StValue] .
  op push : Type StValue List{Field} -> [StValue] .
  op pop : Type StValue List{Field} -> [StValue] .

  vars T Q E : Type .
  vars V X W : StValue .
  vars S R : Struct .
  var M : MapStruct .
  var A : Array .
  vars F G : Field .
  vars I L : Int .
  var N : Nat .
  var P : List{Field} .

  *** Raw histories and wrappers.
  eq select(T,mtst,F) = def(T) .
  eq select(T,store(S,F,V),F) = V .
  ceq select(T,store(S,F,V),G) = select(T,S,G) if F =/= G .
  eq select(T,map(S),F) = select(T,S,F) .
  eq select(intT,array(S),length) = select(intT,S,length) .
  ceq select(T,array(S),I) = select(T,S,I)
    if I >= 0 /\ I < select(intT,S,length) .

  eq find(T,V,nil) = V .
  eq find(T,V,F nil) = select(T,V,F) .
  eq find(T,V,F G P) = find(T,select(structT,V,F),G P) .

  *** A primitive leaf is the only assignment that resolves without another
  *** selector.  Aggregate leaves remain save terms.
  eq save(V,nil,I) = I .

  *** A nonempty mapping/array update enters its wrapper.  Array writes are
  *** admitted only in bounds; with no equation, an invalid update remains a
  *** kind-level barrier and no disjoint observation can pass through it.
  eq save(map(S),F P,X) = map(save(S,F P,X)) .
  eq save(array(S),length nil,I) = array(save(S,length nil,I)) .
  ceq save(array(S),I P,X) = array(save(S,I P,X))
    if I >= 0 /\ I < select(intT,S,length) .

  *** Matching selectors expose the pending write.  Prefix observations keep
  *** save suspended on the old subtree; disjoint selectors see the old value.
  eq select(T,save(S,F nil,X),F) = save(select(T,S,F),nil,X) .
  eq select(T,save(S,F G P,X),F) = save(select(structT,S,F),G P,X) .
  ceq select(T,save(S,length nil,I),G) = select(T,S,G)
    if length =/= G .
  ceq select(T,save(S,F P,X),G) = select(T,S,G)
    if F =/= G /\ W := find(structT,S,F P) .

  *** Struct and array value assignments are interpreted only when selected.
  *** MapStruct is intentionally absent: explicit mapping copies stay stuck.
  eq select(T,save(S,nil,R),F) =
       save(select(T,S,F),nil,select(T,R,F)) .
  eq select(intT,save(S,nil,array(R)),length) = select(intT,R,length) .
  ceq select(T,save(S,nil,array(R)),I) =
        save(select(T,S,I),nil,select(T,R,I))
    if I >= 0 /\ I < select(intT,R,length) .
  eq select(intT,save(array(S),nil,array(R)),length) =
       select(intT,R,length) .
  ceq select(T,save(array(S),nil,array(R)),I) =
        save(select(T,S,I),nil,select(T,R,I))
    if I >= 0 /\ I < select(intT,R,length) .

  *** Primitive deletion resolves to zero.  Nonempty mapping/array deletions
  *** enter the wrapper, with the same array-bounds barrier as save.
  eq delete(intT,I,nil) = 0 .
  eq delete(T,map(S),F P) = map(delete(T,S,F P)) .
  ceq delete(T,array(save(delete(arrayT(E),S,nil),length nil,L)),I P) =
        array(save(delete(T,delete(arrayT(E),S,nil),I P),length nil,L))
    if I >= 0 /\ I < L .
  ceq delete(T,array(S),I P) = array(delete(T,S,I P))
    if I >= 0 /\ I < select(intT,S,length) .

  *** Path deletion is observational, just like assignment.
  eq select(Q,delete(T,S,F nil),F) = delete(T,select(T,S,F),nil) .
  eq select(Q,delete(T,S,F G P),F) =
       delete(T,select(structT,S,F),G P) .
  ceq select(Q,delete(T,S,F P),G) = select(Q,S,G)
    if F =/= G /\ W := find(T,S,F P) .

  *** Whole structs recursively expose deletion markers.  If the selected
  *** member is a mapping, the MapStruct rules below retain its original data.
  eq select(T,delete(structT,S,nil),F) = delete(T,select(T,S,F),nil) .
  eq select(T,delete(Q,M,nil),F) = select(T,M,F) .

  *** A deleted array has length zero.  The raw old slots stay below its marker
  *** and become visible only after growth; then deletion clears ordinary data
  *** while the whole-mapping rule above preserves mappings.
  eq select(intT,delete(arrayT(T),A,nil),length) = 0 .
  eq save(delete(arrayT(T),array(S),nil),length nil,I) =
       array(save(delete(arrayT(T),S,nil),length nil,I)) .
  eq select(intT,delete(arrayT(T),S,nil),length) = 0 .
  eq select(Q,delete(arrayT(T),S,nil),I) =
       delete(T,select(T,S,I),nil) .

  *** Array maintenance is expressed solely in terms of the public operations.
  *** push(value) grows before writing; push() grows before deleting the reused
  *** slot; pop deletes the last slot before shrinking.  Zero has no predecessor,
  *** so an empty pop has no matching equation.
  ceq push(V,P,X) = save(save(V,P length,L + 1),P L,X)
    if L := find(intT,V,P length) .
  ceq push(T,V,P) = delete(T,save(V,P length,L + 1),P L)
    if L := find(intT,V,P length) .
  ceq pop(T,V,P) = save(delete(T,V,P N),P length,N)
    if s N := find(intT,V,P length) .

  ops fld1 fld2 child balances values items : -> Field [ctor] .
endfm

*** Latest write, typed defaults, absent prefixes, and wrapper traversal.
red select(intT,store(store(mtst,fld1,1),fld1,2),fld1) .       *** 2
red select(intT,mtst,fld1) .                                  *** 0
red select(structT,mtst,fld1) .                               *** mtst
red select(mapT(intT),mtst,balances) .                        *** map(mtst)
red select(arrayT(intT),mtst,values) .                        *** array(store(mtst,length,0))
red find(intT,save(mtst,fld1 child,7),fld1 child) .            *** 7
red find(intT,save(map(mtst),4 child,9),4 child) .             *** 9
red find(intT,save(array(store(store(mtst,length,1),0,
                               store(mtst,child,8))),0 child,9),
         0 child) .                                            *** 9
red find(structT,save(mtst,fld1 child,7),fld1) .
                                                               *** save(mtst,child,7)

*** Exact aggregate reads stay suspended; their fields are read lazily.
red find(structT,save(store(mtst,fld1,1),nil,
                      store(mtst,fld1,2)),nil) .
                                                               *** save(...)
red find(intT,save(store(mtst,fld1,1),nil,
                   store(mtst,fld1,2)),fld1) .                 *** 2
red find(arrayT(intT),
         save(array(store(store(mtst,length,1),0,1)),nil,
              array(store(store(mtst,length,1),0,2))),nil) .
                                                               *** save(...)
red find(intT,
         save(array(store(store(mtst,length,1),0,1)),nil,
              array(store(store(mtst,length,1),0,2))),0) .      *** 2

*** Copies are observationally independent after either side is updated.
red find(intT,
         save(save(store(mtst,fld1,store(mtst,child,5)),fld2,
                   find(structT,store(mtst,fld1,store(mtst,child,5)),fld1)),
              fld1 child,8),
         fld2 child) .                                         *** 5
red find(intT,
         save(save(store(mtst,fld1,
                              array(store(store(mtst,length,1),0,5))),
                   fld2,
                   find(arrayT(intT),
                        store(mtst,fld1,
                              array(store(store(mtst,length,1),0,5))),fld1)),
              fld1 0,8),
         fld2 0) .                                             *** 5

*** EXPECT STUCK (explicit mapping copy: direct and nested).
red find(mapT(intT),save(map(mtst),nil,map(store(mtst,1,9))),nil) .
red find(intT,
         save(store(mtst,balances,map(mtst)),nil,
              store(mtst,balances,map(store(mtst,1,9)))),
         balances 1) .

*** Primitive, recursive-struct, whole-map, entry, and whole-array deletion.
red find(intT,delete(intT,7,nil),nil) .                         *** 0
red find(structT,delete(structT,store(mtst,fld1,7),nil),nil) .
                                                               *** delete(...)
red find(intT,delete(structT,store(mtst,fld1,7),nil),fld1) .    *** 0
red find(intT,
         delete(structT,
                store(store(mtst,fld1,7),balances,
                      map(store(mtst,1,9))),nil),balances 1) .  *** 9
red find(intT,delete(mapT(intT),map(store(mtst,1,9)),nil),1) . *** 9
red find(intT,delete(intT,map(store(mtst,1,9)),1),1) .         *** 0
red find(arrayT(intT),
         delete(arrayT(intT),
                array(store(store(mtst,length,1),0,9)),nil),nil) .
                                                               *** delete(...)
red find(intT,
         delete(arrayT(intT),
                array(store(store(mtst,length,1),0,9)),nil),length) .
                                                               *** 0

*** Bounds, pushes, and pop.  Labelled cases are intentionally stuck.
red find(intT,save(array(store(store(mtst,length,1),0,11)),0,12),0) .
                                                               *** 12
red find(intT,save(array(store(store(mtst,length,1),0,11)),0,12),length) .
                                                               *** 1
red find(intT,
         save(store(store(mtst,values,
                          array(store(store(mtst,length,1),0,11))),fld1,7),
              values 0,12),fld1) .                             *** 7
*** EXPECT STUCK (out-of-bounds read).
red find(intT,array(store(store(mtst,length,1),0,11)),1) .
*** EXPECT STUCK (invalid write blocks matching observation).
red find(intT,save(array(store(mtst,length,0)),0,12),0) .
*** EXPECT STUCK (invalid write blocks disjoint observation).
red find(intT,save(array(store(mtst,length,0)),0,12),length) .
*** EXPECT STUCK (nested invalid write blocks a root-disjoint observation).
red find(intT,
         save(store(store(mtst,values,array(store(mtst,length,0))),fld1,7),
              values 0,12),fld1) .
red find(intT,push(array(store(mtst,length,0)),nil,11),0) .     *** 11
red find(intT,push(intT,array(store(mtst,length,0)),nil),0) .  *** 0
red find(intT,push(array(store(mtst,length,0)),nil,11),length) .
                                                               *** 1
red find(intT,
         pop(intT,push(array(store(mtst,length,0)),nil,11),nil),length) .
                                                               *** 0
*** EXPECT STUCK (empty pop).
red pop(intT,array(store(mtst,length,0)),nil) .

*** Nested mappings survive pop/push reuse and whole-array delete/push reuse;
*** ordinary fields are cleared.
red find(intT,
         push(structT,
              pop(structT,
                  array(store(store(mtst,length,1),0,
                              store(store(mtst,fld1,7),balances,
                                    map(store(mtst,3,44))))),nil),nil),
         0 fld1) .                                             *** 0
red find(intT,
         push(structT,
              pop(structT,
                  array(store(store(mtst,length,1),0,
                              store(store(mtst,fld1,7),balances,
                                    map(store(mtst,3,44))))),nil),nil),
         0 balances 3) .                                       *** 44
red find(intT,
         push(structT,
              delete(arrayT(structT),
                     array(store(store(mtst,length,1),0,
                                 store(store(mtst,fld1,7),balances,
                                       map(store(mtst,3,44))))),nil),nil),
         0 fld1) .                                             *** 0
red find(intT,
         push(structT,
              delete(arrayT(structT),
                     array(store(store(mtst,length,1),0,
                                 store(store(mtst,fld1,7),balances,
                                       map(store(mtst,3,44))))),nil),nil),
         0 balances 3) .                                       *** 44
