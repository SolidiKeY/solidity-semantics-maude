*** src/Storage.maude — the nested/lazy storage model.
***
*** SIBLING: ../src/StorageCopy.maude is the variant aligned with SolKey's
*** current structRules.key. This file is deliberately left as it was, so the
*** two can be compared; src/sem/ runs on StorageCopy. Three deltas there:
***   1. save's leaf does not collapse -- a struct copy keeps the TARGET's
***      mapping members, since Solidity never copies a mapping. Here
***      `find(save(st,p,v), p) = v` takes them from the SOURCE.
***   2. delete is sort-directed (delValue/delNode), so the exact read of a
***      deleted struct slot is a delete-marked struct rather than a
***      primitive default, and a delete of a strict descendant survives a
***      copy of its ancestor. Here both are lost.
***   3. push() clears the appended slot (SolKey storagePushLengthSave).

load Fields .

fmod STORAGE{Field :: TRIV} is
    pr FIELDS{Field} .
    pr LIST{Field} .

    sort Struct .

    subsort Struct < StValue .   *** structHeader.key: Struct \extends StValue

    *** signatures mirror SolKey structRules.key: storage holds StValue
    op mtSt : -> Struct .
    op storeSt : Struct Field$Elt StValue -> Struct .
    op selectSt : Struct Field$Elt -> StValue .
    op find : Struct List{Field} -> StValue .
    op save : Struct NeList{Field} StValue -> Struct .
    op push : Struct NeList{Field} StValue -> Struct .
    op push : Struct NeList{Field} -> Struct .
    op pop : Struct NeList{Field} -> Struct .

    vars st nSt : Struct .
    var fld : Field$Elt .
    var idF : RefField .
    var val : StValue .
    var flds flds2 : List{Field} .
    var fldsN fldsN2 : NeList{Field} .
    vars nl old_length : Int .

    mb find(st, idF) : Struct .

    eq find(storeSt(st, fld, val), fld flds) = find(val, flds) .
    eq find(val, nil) = val .

    op v→st : Value -> Struct .
    eq v→st(st) = st .

    eq find(find(st, fldsN), fldsN2) =  find(st, fldsN fldsN2) .
    eq find(save(st, fldsN, val), fldsN) = val .
    eq find(save(st, fldsN fldsN2, val), fldsN) = save(find(st, fldsN), fldsN2, val) .
    ceq find(save(st, fldsN, val), fldsN2) = find(st, fldsN2)
        if fldsN =/= fldsN2 [owise] .

    ceq push(st, fldsN, val) = save(nSt, fldsN length, s old_length)
        if old_length := find(st, fldsN length) /\ s nl := old_length /\ nSt := save(st, fldsN nl, val) .
    eq push(st, fldsN) = save(st, fldsN length, s find(st, fldsN length)) .
    *** pop is defined below, in terms of delAt (delete the last element, skipping mappings)

    *** ---- delete (skips mappings) --------------------------------------
    op delAt : Struct NeList{Field} -> Struct .   *** lazy delete (skips mappings), resolved by find

    var pf : PrimField .   var idf : RefField .   var mapf : MapField .   var i : Int .
    var dp : NeList{Field} .
    vars pre rest qp : List{Field} .

    eq delAt(st, pre mapf) = st .   *** delete m : whole-mapping no-op (fires before find can mis-recurse a map key)

    *** read-through: query strictly below the deleted path dp
    eq find(delAt(st, dp), dp pf)        = defaultValue(pf) .                          *** reset primitive member
    eq find(delAt(st, dp), dp idf rest)  = find(delAt(st, dp idf), dp idf rest) .   *** recurse into referenced struct/array
    eq find(delAt(st, dp), dp i rest)    = find(delAt(st, dp i),   dp i rest) .     *** recurse into keyed element
    eq find(delAt(st, dp), dp mapf rest) = find(st, dp mapf rest) .               *** PRESERVE mapping: read original

    *** exact read of the deleted node itself (query == dp)
    eq find(delAt(st, pre idf), pre idf) = defaultValue(idf) .   *** deleted struct/array -> its default (e.g. mtSt)
    eq find(delAt(st, pre i),   pre i)   = 0 .              *** deleted element / value at a key -> 0
    eq find(delAt(st, pre pf),  pre pf)  = defaultValue(pf) .    *** deleted primitive -> its default (was the eager delete)

    *** disjoint path / ancestor read: pass through to the original
    eq find(delAt(st, dp), qp) = find(st, qp) [owise] .

    *** ---- pop = delete the last element (skips mappings), then shrink length ----
    ceq pop(st, fldsN) = save(delAt(st, fldsN nl), fldsN length, nl)
        if old_length := find(st, fldsN length) /\ s nl := old_length .
endfm

fmod Example{Field :: TRIV} is
    pr STORAGE{Field} .

    ops $alice $bob $carol $account $a : -> RefField .
    ops $balance : -> PrimField .
    op $m : -> MapField .
    ops st stEx stEx2 stD stArr stPop : -> Struct .

    var pf : PrimField .
    eq defaultValue(pf) = 0 .          *** every primitive reset is 0 (incl. defaultValue(length) = 0)
    eq defaultValue($account) = mtSt .
    eq defaultValue($a) = mtSt .

    eq stEx = save(save(st, $alice $account length, 10), $alice $account 5, 20) .

    eq stEx2 = save(st, $account length, 10) .

    *** delete tests: struct with a primitive, a nested struct, and a mapping
    eq stD   = save(save(save(st, $alice $balance, 5), $alice $account $balance, 7), $alice $m 9, 42) .
    *** delete tests: a dynamic array (length slot + element)
    eq stArr = save(save(st, $a length, 3), $a 1, 100) .
    *** pop test: array of structs, element 0 holds a nested mapping ($m) and a primitive ($balance)
    *** mirrors ledgerUses[0].ledger.balances[1]=10 / .nonce=5  ($a=array, $account=nested struct)
    eq stPop = save(save(save(st, $a length, 1), $a 0 $account $m 1, 10), $a 0 $account $balance, 5) .
endfm

red find(stEx, $alice $account length) .
red find(stEx, $alice $account 5) .
red find(stEx, $alice) .

red push(stEx2, $account, 20) .
red pop(stEx, $alice $account) .

red push(stEx2, $account) .

*** ---- delete (nested / lazy) --------------------------------------------
red find(delAt(stEx2, $account length), $account length) .  *** 0   value-type reset
red find(delAt(stD, $alice),      $alice $balance) .        *** 0   sibling primitive reset
red find(delAt(stD, $alice),      $alice $account $balance) . *** 0  nested struct reset
red find(delAt(stD, $alice),      $alice $m 9) .            *** 42  MAP PRESERVED (critical)
red find(delAt(stD, $alice $m),   $alice $m 9) .            *** 42  delete m : no-op
red find(delAt(stD, $alice $m 9), $alice $m 9) .            *** 0   delete m[9] : one entry reset
red find(delAt(stD, $alice $m 9), $alice $m 3) .            *** find(st, $alice $m 3)  other key untouched
red find(delAt(stArr, $a),        $a length) .              *** 0   whole-array delete: length 0
red find(delAt(stArr, $a 1),      $a length) .              *** 3   delete arr[1]: length untouched
red find(delAt(stArr, $a 1),      $a 1) .                   *** 0

*** ---- pop = delete last element (skips mappings) -------------------------
red find(pop(stPop, $a), $a length) .                        *** 0
red find(push(pop(stPop, $a), $a), $a length) .              *** 1
red find(push(pop(stPop, $a), $a), $a 0 $account $m 1) .     *** 10  MAP PRESERVED across pop+push (paper's last test)
red find(push(pop(stPop, $a), $a), $a 0 $account $balance) . *** 0   nested primitive reset by pop
