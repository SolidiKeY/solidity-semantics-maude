*** src/sem/examples/solkey/Store.maude
***
*** The TestSuite.sol field vocabulary shared by the solkey mirror suite.
*** Each sibling file loads this and re-expresses the corresponding
*** `keyext.solidity.examples/TestSuite.sol` functions (the ones SolKey
*** proves with postcondition `true`) as Maude Hoare triples, so we can
*** cross-check that this semantics agrees with what SolKey proves.
***
*** Translation dictionary (SolKey  ->  Maude):
***   \<{ f()@TestSuite; }\>(true)  < body-of-f > (post)   diamond triple, empty storage
***   /// @custom:key box + require(x == v)   the pin becomes `var 'x = v ;`
***   require(arr.length == n)      n leading pushes (zero-init makes length 0)
***   alice.age                     $alice . $age
***   values[1]                     $values [ 1 ]
***   result = e; ... (result=v)    folded into the postcondition, or `var 'result = e ;`
***   TRUE / FALSE                  1 / 0   (bools are EVM ints here)
***   find<[int]>(storage, cons2(A,B))   $A . $B   (read in the postcondition)
***   \[{ P }\](false)              < P > reverts   (box-false = the program blocks/reverts)
***
*** Field sorts mirror SolKey's parse-time sort stamping (fieldSortFor):
***   value member            -> PrimField      (SolKey: plain Field)
***   struct / array member   -> RefField
***   mapping member          -> MapField
*** ...and the element-kind refinements RefArrField / RefMapField mark
*** containers whose ELEMENTS are structs/arrays, standing in for SolKey's
*** MappingSort/ArraySort value sorts + the find<[Struct]> cast.
***
*** TestSuite.sol structs (nesting mirrored by the field paths):
***   Token   { value }             $value:Prim
***   Account { balance, token }    $balance:Prim  $token:Ref
***   Person  { account, age }      $account:Ref   $age:Prim
***   Ledger  { nonce, balances }   $nonce:Prim    $balances:Map
***   Toggle  { on, n }             $on:Prim
***   TokenBucket { tokens }        $tokens:RefArr
*** `age`/`balance` double as top-level slots and struct members — the same
*** selector on a different PATH, so one constant each serves both.

load ../../Hoare .

fmod PAPER-STORE{Field :: TRIV} is
    pr SOL-HOARE{Field} .

    *** reference-valued selectors (structs, and arrays of primitives)
    ops $alice $bob $account $token $values $boolFlags $toggle $bucket $ledger : -> RefField .
    *** arrays of structs/arrays: an indexed read is a Struct
    ops $matrix $persons $tokens : -> RefArrField .
    *** primitive selectors
    ops $value $balance $age $total $owner $flag $flag2 $on $nonce : -> PrimField .
    *** mappings with primitive values
    ops $balances $flags : -> MapField .
    *** mappings with struct values: an indexed read is a Struct
    ops $people $accountMap : -> RefMapField .

    *** zero-initialization: primitives to 0, references (structs/arrays) to mtSt
    eq defaultValue($value) = 0 .    eq defaultValue($balance) = 0 .   eq defaultValue($age) = 0 .
    eq defaultValue($total) = 0 .    eq defaultValue($owner) = 0 .     eq defaultValue(length) = 0 .
    eq defaultValue($flag) = 0 .     eq defaultValue($flag2) = 0 .     eq defaultValue($on) = 0 .
    eq defaultValue($nonce) = 0 .
    eq defaultValue($alice) = mtSt .   eq defaultValue($bob) = mtSt .     eq defaultValue($account) = mtSt .
    eq defaultValue($token) = mtSt .   eq defaultValue($values) = mtSt .  eq defaultValue($matrix) = mtSt .
    eq defaultValue($persons) = mtSt . eq defaultValue($tokens) = mtSt .  eq defaultValue($boolFlags) = mtSt .
    eq defaultValue($toggle) = mtSt .  eq defaultValue($bucket) = mtSt .  eq defaultValue($ledger) = mtSt .
endfm
