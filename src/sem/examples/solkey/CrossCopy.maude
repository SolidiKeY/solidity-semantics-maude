*** src/sem/examples/solkey/CrossCopy.maude
***
*** Mirror of the TestSuite.sol cross-location copy family — the repo's core
*** artifact driven end-to-end:
***   testMemoryToStorageCopyRoot / -Field / -ComplexSource / -ComplexTarget,
***   testStorageToMemoryCopyRoot / -Field / -ComplexPath,
***   testMemoryFieldShallowCopy.
*** memory -> storage and storage -> memory are value COPIES (later writes to
*** the source are invisible); memory -> memory is reference aliasing.
*** SolKey's default-initialized `T memory x;` becomes `memory 'x = new ;`.

load Store .

fmod CROSSCOPY-DEMO{Field :: TRIV} is
    pr PAPER-STORE{Field} .
endfm

*** ---- testMemoryToStorageCopyRoot: alice = carol snapshots the object ----
red < memory 'carol = new ;
      'carol . $age = # 42 ;
      $alice = 'carol ;
      'carol . $age = # 43 ; > ($alice . $age == # 42) .                      *** true

*** ---- testMemoryToStorageCopyField: alice.account = carolAcc ----
red < memory 'carolAcc = new ;
      'carolAcc . $balance = # 50 ;
      $alice . $account = 'carolAcc ;
      'carolAcc . $balance = # 51 ; > ($alice . $account . $balance == # 50) .   *** true

*** ---- testMemoryToStorageCopyComplexSource: alice.account = carol.account ----
red < memory 'carol = new ;
      'carol . $account . $balance = # 50 ;
      $alice . $account = 'carol . $account ;
      'carol . $account . $balance = # 51 ; > ($alice . $account . $balance == # 50) .   *** true

*** ---- testMemoryToStorageCopyComplexTarget: alice.account.token = carolToken ----
red < memory 'carolToken = new ;
      'carolToken . $value = # 99 ;
      $alice . $account . $token = 'carolToken ;
      'carolToken . $value = # 100 ; > ($alice . $account . $token . $value == # 99) .   *** true

*** ---- testStorageToMemoryCopyRoot: Person memory carol = alice ----
red < $alice . $age = # 25 ;
      memory 'carol = $alice ;
      $alice . $age = # 30 ;
      var 'v = 'carol . $age ; > ('v == # 25) .                             *** true

*** ---- testStorageToMemoryCopyField: Account memory acc = alice.account ----
red < $alice . $account . $balance = # 10 ;
      memory 'acc = $alice . $account ;
      $alice . $account . $balance = # 20 ;
      var 'v = 'acc . $balance ; > ('v == # 10) .                           *** true

*** ---- testStorageToMemoryCopyComplexPath: Token memory t = alice.account.token ----
red < $alice . $account . $token . $value = # 17 ;
      memory 't = $alice . $account . $token ;
      $alice . $account . $token . $value = # 18 ; > ('t . $value == # 17) .  *** true

*** ---- testMemoryFieldShallowCopy: carol.account = david.account ALIASES ----
red < memory 'carol = new ; memory 'david = new ;
      'david . $account . $balance = # 50 ;
      'carol . $account = 'david . $account ;
      'carol . $account . $balance = # 60 ; >
      ('david . $account . $balance == # 60 && 'carol . $account . $balance == # 60) .   *** true
