*** src/sem/examples/solkey/Bool.maude
***
*** Mirror of the TestSuite.sol storage-bool family:
***   storageBoolRootReadWrite, storageBoolRootCopy, storageBoolFieldRead,
***   storageBoolMappingRead, storageBoolArrayRead, storageBoolFieldStoreRoot.
*** SolKey gives bool its own Prim sort (boolHeader.key); here bools are EVM
*** Ints 1/0, so `flag = true;` stores 1 (`LV = P ;` evaluates the Prop) and
*** `assert(r)` becomes `== 1`. storageBoolArrayRead's box precondition
*** `require(boolFlags.length == 1)` becomes a leading push.

load Store .

fmod BOOL-DEMO{Field :: TRIV} is
    pr PAPER-STORE{Field} .
endfm

*** ---- storageBoolRootReadWrite: flag = true; bool r = flag; assert(r) ----
red < $flag = true ; var 'r = $flag ; > ('r == # 1) .                       *** true

*** ---- storageBoolRootCopy: flag2 = flag copies the stored bool ----
red < $flag = true ; $flag2 = $flag ; var 'r = $flag2 ; > ('r == # 1) .     *** true

*** ---- storageBoolFieldRead: toggle.on = true; assert(toggle.on) ----
red < $toggle . $on = true ; var 'r = $toggle . $on ; > ('r == # 1) .       *** true

*** ---- storageBoolMappingRead: flags[2] = true ----
red < $flags [ # 2 ] = true ; var 'r = $flags [ # 2 ] ; > ('r == # 1) .         *** true

*** ---- storageBoolArrayRead (box): require(length == 1) -> one push ----
red < $boolFlags .push(# 0) ;
      $boolFlags [ # 0 ] = true ;
      var 'r = $boolFlags [ # 0 ] ; > ('r == # 1) .                           *** true

*** ---- storageBoolFieldStoreRoot: flag = toggle.on ----
red < $toggle . $on = true ; $flag = $toggle . $on ; var 'r = $flag ; > ('r == # 1) .   *** true
