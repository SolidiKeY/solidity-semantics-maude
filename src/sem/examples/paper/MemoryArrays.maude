*** ---- :140  carol.account.values[i] = val;   a nested memory array ----
red run(< memory 'carol = new ;
          memory 'vs = new(# 2) ;
          'carol . $account . $values = 'vs ;
          var 'i = # 1 ;
          'carol . $account . $values [ 'i ] = # val ; >) .
*** {memory := write(write(write(addM(addM(emptyMemory,
*** pid(0)), pid( 1)), idC(pid(1), nil), length, 2), idC(pid(0), $account),
*** $values, idC(pid( 1), nil)), idC(pid(1), nil), 1, val) || 'carol :=
*** idC(pid(0), nil) || 'i := 1 || 'vs := idC(pid(1), nil)}
red < memory 'carol = new ; memory 'vs = new(# 2) ;
      'carol . $account . $values = 'vs ; var 'i = # 1 ;
      'carol . $account . $values [ 'i ] = # val ; > ('carol . $account . $values [ # 1 ] == # val) .  *** true

