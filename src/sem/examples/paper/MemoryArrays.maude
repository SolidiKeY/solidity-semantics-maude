*** src/sem/examples/paper/MemoryArrays.maude
***
*** sections/memory-examples-arrays.tex — indexed memory access.
***
*** Adaptation used throughout: a memory array is allocated with a SIZE,
*** `memory q = new(n) ;`, and any element that is later read is written first.
*** BANK has no default for an Int selector (src/Memory.maude:39-41 covers a
*** primitive and a reference selector only), so an untouched memory slot is
*** simply not readable — unlike storage, which zero-initializes. Indices are
*** concrete, because a memory index is bounds-checked against the length slot.
*** The rows using `makeValue()` are UNSUPPORTED: a call in expression position.

load Domain .

fmod PAPER-MEMORY-ARRAYS{Field :: TRIV} is
    pr PAPER-STEPS{Field} .
endfm

*** ---- :4  v = carolValues[i];   in bounds, then out of bounds ------------
red run(< memory 'carolValues = new(# 2) ;
          'carolValues [ # 1 ] = # val ;
          var 'i = # 1 ;
          var 'v = 'carolValues [ 'i ] ; >) .
*** {memory := write(write(addM(emptyMemory, pid(0)),
*** idC(pid(0), nil), length, 2), idC(pid(0), nil), 1, val) || 'carolValues
*** := idC(pid(0), nil) || 'i := 1 || 'v := val}
red < memory 'carolValues = new(# 2) ; 'carolValues [ # 1 ] = # val ;
      var 'i = # 1 ; var 'v = 'carolValues [ 'i ] ; > ('v == # val) .            *** true
red < memory 'carolValues = new(# 2) ; var 'i = # 2 ;
      var 'v = 'carolValues [ 'i ] ; > reverts .                                 *** true

*** ---- :32  carolValues[i] = 100; --------------------------------------
red run(< memory 'carolValues = new(# 2) ; var 'i = # 1 ;
          'carolValues [ 'i ] = # 100 ; >) .
*** {memory := write(write(addM(emptyMemory, pid(0)),
*** idC(pid(0), nil), length, 2), idC(pid(0), nil), 1, 100) || 'carolValues
*** := idC(pid(0), nil) || 'i := 1}

*** ---- :47  v = carolValues[++i];   an impure index -------------------
red run(< memory 'carolValues = new(# 3) ;
          'carolValues [ # 1 ] = # val ;
          var 'i = # 0 ;
          var 'v = 'carolValues [ ++ 'i ] ; >) .
*** {memory := write(write(addM(emptyMemory, pid(0)),
*** idC(pid(0), nil), length, 3), idC(pid(0), nil), 1, val) || 'carolValues
*** := idC(pid(0), nil) || 'i := 1 || 'v := val || tq(0) := 1}
red < memory 'carolValues = new(# 3) ; 'carolValues [ # 1 ] = # val ;
      var 'i = # 0 ; var 'v = 'carolValues [ ++ 'i ] ; > ('i == # 1 && 'v == # val) .   *** true

