*** src/sem/examples/paper/StorageCopyMapping.maude
***
*** No paper section: this is SolKey's copyKeepsMapping.key obligation, replayed
*** in the paper's derivation notation. `ledger2 = ledger;` is a storage ->
*** storage struct copy over a location that owns a MAPPING, and Solidity never
*** copies a mapping -- so the value members come from the SOURCE while the
*** mapping members stay the TARGET's own. The one-shot Hoare form of this lives
*** in ../solkey/Copy.maude:113; here every intermediate state is visible.
***
*** The same program under the OTHER storage model is in the file next to this
*** one, StorageCopyMappingFlagged.maude. It is a separate file because the
*** sem/ layer holds one storage model per session.
***
*** HOW THE MODEL DOES IT -- see ../../../StorageCopy.maude:115-137.
***
*** Nothing is dropped at WRITE time. The right-hand side is evaluated eagerly
*** to a struct value -- find(S, $ledger) extracts the whole source subtree,
*** mapping entries included -- and asg writes it with save(S, $ledger2, that).
*** Block A shows the written value carrying the source's `$balances 1 -> 11`.
***
*** The mapping is skipped at READ time. A read that reaches the written path
*** builds the non-collapsing leaf
***
***     find(save(st, p, str), p flds) = find(ovr(v->st(find(st, p)), str), flds)
***
*** that is, ovr(TARGET-old, SOURCE-new): SolKey's irreducible save(st, nil, v).
*** The four ovr equations then dispatch on the sort of the next field --
*** mapping members read LEFT, everything else reads RIGHT:
***
***     find(ovr(st, str), mapf flds) = find(st, mapf flds)    mapping: the TARGET's own
***     find(ovr(st, str), pf flds)   = find(str, pf flds)     primitive: the SOURCE's
***     find(ovr(st, str), i flds)    = find(str, i flds)      element:   the SOURCE's
***     find(ovr(st, str), rf flds)   = find(ovr(v->st(find(st, rf)),
***                                             find(str, rf)), flds)    ref: leaf one level down
***
*** So the copy is not a merge and not a filter: the source struct is written
*** whole, and the READER decides which side each member comes from.
***
*** WHAT EACH BLOCK SHOWS
***   A  the derivation, one ~> per statement, with the written struct value
***   B  the same claim written out and CHECKED, plus its negation as false
***   C  B's two reads CONTINUED, one ~> per find equation wherever it
***      fires -- inner reads included -- in both models
***   D  a key the target never wrote: not merged, not copied -- just 0
***   E  the leaf itself, printed: copying the copy leaves ovr(...) in storage
***   F  the RefField equation: the same split one level down, via alice = bob
***
*** WHY C EXISTS. A and B step STATEMENTS, so the whole read of a location is
*** one arrow and the four ovr equations above never appear: B goes straight
*** from the copy's storage to `'n := 5 || 'b := 0`. C takes those two reads
*** and steps the storage model instead, so the arrow that chooses the side is
*** the thing on the page. It is not a second derivation -- the terms it steps
*** are B's own, constant by constant, and the reductions right above it are
*** what pin them to B.
***
*** THE TARGET IS NOT SET UP in A and B. The program writes only $ledger, so the
*** target's own mapping entry is unset and the copied read of $balances[1]
*** answers 0, not a value the target wrote. That is weaker evidence on its own
*** -- a reset answers 0 too -- so the discrimination is carried elsewhere: C3
*** keeps a target write of 77 and reads it back through the leaf, D reads a key
*** the SOURCE set to 22 and still gets 0, and E keeps 77 at the statement level.
***
*** WHAT `base: false` MEANS HERE. It marks a reduction that flips if you point
*** ../../Config.maude at ../../../Storage.maude instead, as ../solkey/Copy.maude
*** already marks this obligation. Do not read it as "the base model copies the
*** mapping": measured, the base model has no struct-copy leaf AT ALL. Its only
*** applicable equation is the disjoint-path passthrough, so a read through a
*** copied struct ignores the copy entirely and resolves against the pre-copy
*** storage. The block-B program there gives 'n := 0 and 'b := 0 -- the copy is
*** invisible, not selective. Mapping preservation does not even arise; that is
*** the latent gap ../../Config.maude:87 flags.
***
*** PAPER-COPY-DOMAIN is the module Steps.maude reflects, so it must NOT import
*** META-LEVEL, and the constants it steps over must be declared INSIDE it: a
*** constant added from outside does not exist in the module metaRewrite runs
*** in. PAPER-STEPS already fixes theModule = 'PAPER-DOMAIN, so the layer below
*** imports SOL-STEPS directly rather than going through it. The same trap is
*** why block C declares its storage terms inside PAPER-CMP-SORTED and
*** PAPER-CMP-FLAGGED rather than in the stepper wrappers above them.
***
*** EVERY `red` NAMES ITS MODULE. Block C introduces modules over a second field
*** signature, in which `$ledger` is a different constant at a different sort,
*** so a bare `red` after them would not mean what it means before them.

load Domain .

fmod PAPER-COPY-DOMAIN{Field :: TRIV} is
    pr PAPER-DOMAIN{Field} .

    *** the copy TARGET: the paper's domain has a single Ledger
    op $ledger2 : -> RefField .
    eq defaultValue($ledger2) = mtSt .

    op $ledger2 : -> Root .
    var Clv : Cells .
    eq lower($ledger2, Clv) = sloc($ledger2) .
endfm

fmod PAPER-COPY-STEPS{Field :: TRIV} is
    pr PAPER-COPY-DOMAIN{Field} .
    pr SOL-STEPS{Field} .
    eq theModule = 'PAPER-COPY-DOMAIN .
endfm

*** ---- A  the derivation ---------------------------------------------------
*** Two setup writes, the copy, then two reads: five statements, five ~>.
*** Below, S2 abbreviates the storage after the two setup writes,
***
***     S2 = save(save(mtSt, $ledger $nonce, 5), $ledger $balances 1, 11)
***
*** The third goal is the one to look at. The copy writes
***
***     save(S2, $ledger2, save(save(mtSt, $nonce, 5), $balances 1, 11))
***
*** and that written value DOES carry the source's mapping entry, 11. Two steps
*** later the read of $ledger2 . $balances[1] answers 0, not 11: the skip
*** happens in find, not in save. A root-to-root assignment prints as
*** `($ledger2).Root = ($ledger).Root ;` -- see Syntax.maude on why a root
*** lvalue is overloaded at sort Root.
red in PAPER-COPY-STEPS :
steps(< $ledger . $nonce = # 5 ;  $ledger . $balances [ # 1 ] = # 11 ;
        $ledger2 = $ledger ;
        var 'n = $ledger2 . $nonce ;
        var 'b = $ledger2 . $balances [ # 1 ] ; >) .
*** < … > ~> {storage := save(mtSt, $ledger $nonce, 5)}< … >
***        ~> {storage := S2}< ($ledger2).Root = ($ledger).Root ; … >
***        ~> {storage := save(S2, $ledger2, save(save(mtSt, $nonce, 5),
***                       $balances 1, 11))}< var 'n = … ; var 'b = … ; >
***        ~> {storage := save(S2, $ledger2, save(save(mtSt, $nonce, 5),
***                       $balances 1, 11)) || 'n := 5}< var 'b = … ; >
***        ~> {storage := save(S2, $ledger2, save(save(mtSt, $nonce, 5),
***                       $balances 1, 11)) || 'b := 0 || 'n := 5}

*** ---- B  the claim, written out and checked -------------------------------
*** The elision above is informal; this is the exact claim, machine-checked.
*** ~*> skips the two setup writes, then one ~> per remaining statement.
red in PAPER-COPY-STEPS :
|- < $ledger . $nonce = # 5 ;  $ledger . $balances [ # 1 ] = # 11 ;
     $ledger2 = $ledger ;
     var 'n = $ledger2 . $nonce ;
     var 'b = $ledger2 . $balances [ # 1 ] ; >
    ~*> { storage := save(save(mtSt, $ledger $nonce, 5),
                    $ledger $balances 1, 11) }
        < $ledger2 = $ledger ;
          var 'n = $ledger2 . $nonce ;
          var 'b = $ledger2 . $balances [ # 1 ] ; >
    ~>  { storage := save(save(save(mtSt, $ledger $nonce, 5),
                    $ledger $balances 1, 11),
                    $ledger2, save(save(mtSt, $nonce, 5), $balances 1, 11)) }
        < var 'n = $ledger2 . $nonce ;
          var 'b = $ledger2 . $balances [ # 1 ] ; >
    ~>  { storage := save(save(save(mtSt, $ledger $nonce, 5),
                    $ledger $balances 1, 11),
                    $ledger2, save(save(mtSt, $nonce, 5), $balances 1, 11))
          || 'n := 5 }
        < var 'b = $ledger2 . $balances [ # 1 ] ; >
    ~>  { storage := save(save(save(mtSt, $ledger $nonce, 5),
                    $ledger $balances 1, 11),
                    $ledger2, save(save(mtSt, $nonce, 5), $balances 1, 11))
          || 'n := 5 || 'b := 0 } .                                        *** true

*** the SAME derivation but claiming 'b came from the SOURCE, 11. This is the
*** reading a COLLAPSING leaf would license -- SolKey deleted its saveOnEmpty
*** rule, `save(st, nil, v) => v`, for exactly this reason. Not derivable here:
*** `|-` decides it false rather than getting stuck.
red in PAPER-COPY-STEPS :
|- < $ledger . $nonce = # 5 ;  $ledger . $balances [ # 1 ] = # 11 ;
     $ledger2 = $ledger ;
     var 'b = $ledger2 . $balances [ # 1 ] ; >
    ~*> { storage := save(save(save(mtSt, $ledger $nonce, 5),
                    $ledger $balances 1, 11),
                    $ledger2, save(save(mtSt, $nonce, 5), $balances 1, 11))
          || 'b := 11 } .                                                  *** false

*** and the same fact as a one-shot triple, the form ../solkey/Copy.maude uses.
*** It is `base: false` on the 'n conjunct: there the copy is invisible and 'n
*** reads 0, the unset target, rather than the source's 5.
red in PAPER-COPY-STEPS :
< $ledger . $nonce = # 5 ;  $ledger . $balances [ # 1 ] = # 11 ;
  $ledger2 = $ledger ;
  var 'n = $ledger2 . $nonce ;
  var 'b = $ledger2 . $balances [ # 1 ] ; >
    ('n == # 5 && 'b == # 0) .                            *** true   base: false

*** ===========================================================================
*** C  B's two reads, continued: one ~> per find equation, in both models
*** ===========================================================================
***
*** B ends `|| 'n := 5 || 'b := 0`. Those two values are what the last two
*** arrows of B computed, and this is how. ../../../FindSteps.maude steps the
*** storage model the way Steps.maude steps statements, so the leaf being built
*** and then dispatched is on the page.
***
*** THE TERMS ARE B's. s2 is the storage of B's `~*>` goal and s3 the storage of
*** its last three goals, constant for constant:
***
***     s2 = save(save(mtSt, $ledger $nonce, 5), $ledger $balances 1, 11)
***     s3 = save(s2, $ledger2, src)        src = the copied source subtree
***
*** so `find(s3, $ledger2 $nonce)` IS the read B's fourth arrow performs and
*** `find(s3, $ledger2 $balances 1)` the read its fifth performs. s2w / s3w are
*** the same with the target's own 77, which is block E's storage; C3 steps that
*** one because it is where the two sides carry different values.
*** `src` is written out rather than as find(s2, $ledger) so that a trace does
*** not open with arrows extracting it; the two reductions below pin it.
***
*** WHICH SIDE. The `ovr` arm that fires is the answer to "does this member come
*** from the target or the source", and it is chosen by the head of the
*** remaining path -- the MapField $balances reads LEFT, the PrimField $nonce
*** reads RIGHT. Same leaf, same storage, two different sides.
***
*** WHICH MODEL. ../../../StorageCopy.maude answers "is this a mapping?" from
*** the FIELD's sort; ../../../StorageFlag.maude answers it from the VALUE at
*** the path, with the mapping slots declared up front and carried as mapOf(...).
*** The sem/ layer above cannot show the second -- ../../Config.maude fixes the
*** storage model for the whole session at line 26 -- so C drops to raw storage
*** terms, where ../../../StorageApi.maude's theory lets both models sit in one
*** file. StorageCopyMappingFlagged.maude is the other half: the same program,
*** at the STATEMENT level, in a session switched over to the flagged model.
*** The systematic head-to-head of the two models is
*** ../../../StorageCompare.maude; this is the one obligation, twice.
***
*** Note that `sload` brings StorageFlag.maude's own standalone check with it,
*** so its ExampleFlag reductions print above these. That is the same deal
*** ../../Config.maude already makes with StorageCopy.maude's Example block,
*** whose reductions print in every file in this directory.

sload ../../../FindSteps .

fmod PAPER-CMP-SORTED is                  *** map-ness in the FIELD's sort
    pr CMP-SORTED .
    ops s2 s2w src s3 s3w : -> Struct .
    eq s2  = save(save(mtSt, $ledger $nonce, 5), $ledger $balances 1, 11) .
    eq s2w = save(s2, $ledger2 $balances 1, 77) .
    eq src = save(save(mtSt, $nonce, 5), $balances 1, 11) .
    eq s3  = save(s2,  $ledger2, src) .
    eq s3w = save(s2w, $ledger2, src) .
endfm

fmod PAPER-CMP-FLAGGED is                 *** map-ness in the STORE
    pr CMP-FLAGGED .
    ops layout s2 s2w src s3 s3w : -> Struct .
    *** the layout IS the model's input: no field here carries a sort
    eq layout = decl(decl(mtSt, $ledger $balances, 0), $ledger2 $balances, 0) .
    eq s2  = save(save(layout, $ledger $nonce, 5), $ledger $balances 1, 11) .
    eq s2w = save(s2, $ledger2 $balances 1, 77) .
    eq src = save(save(save(mtSt, $balances, mapOf(0)), $nonce, 5), $balances 1, 11) .
    eq s3  = save(s2,  $ledger2, src) .
    eq s3w = save(s2w, $ledger2, src) .
endfm

fmod PAPER-FIND-SORTED is
    pr PAPER-CMP-SORTED .  pr FIND-TRACE{Sorted} .
endfm

fmod PAPER-FIND-FLAGGED is
    pr PAPER-CMP-FLAGGED .  pr FIND-TRACE{Flagged} .
endfm

*** `src` really is what the copy writes, in each model on its own terms
red in PAPER-CMP-SORTED  : find(s2, $ledger) == src .                      *** true
red in PAPER-CMP-FLAGGED : find(s2, $ledger) == src .                      *** true

*** ---- C1  B's fourth arrow: $nonce, the PrimField arm, reads RIGHT --------
*** Eight arrows, and the first six are the leaf being ASSEMBLED. Arrow 1
*** suspends the copy as ovr(v->st(find(s2, $ledger2)), src) -- selectOnSaveCons
*** -- with the target's old value still UNREAD. Arrows 2-4 are that sub-read:
*** s2 is peeled one write at a time by the disjoint-path passthrough until it
*** reaches mtSt, whose RefField default is mtSt. Arrow 5 is the v->st cast.
*** Only at arrow 6 is the leaf ovr(mtSt, src) ready to dispatch, and arrow 7
*** is the dispatch. $nonce is a PrimField, so it reads RIGHT: the source's 5.
red in PAPER-FIND-SORTED : findSteps('PAPER-CMP-SORTED, find(s3, $ledger2 $nonce)) .
*** find(s3, $ledger2 $nonce)
***  ~> find(ovr(v→st(find(save(save(mtSt, $ledger $nonce, 5), $ledger
***         $balances 1, 11), $ledger2)), save(save(mtSt, $nonce, 5),
***         $balances 1, 11)), $nonce)
***  ~> find(ovr(v→st(find(save(mtSt, $ledger $nonce, 5), $ledger2)),
***         save(save(mtSt, $nonce, 5), $balances 1, 11)), $nonce)
***  ~> find(ovr(v→st(find(mtSt, $ledger2)), save(save(mtSt, $nonce, 5),
***         $balances 1, 11)), $nonce)
***  ~> find(ovr(v→st(mtSt), save(save(mtSt, $nonce, 5), $balances 1,
***         11)), $nonce)
***  ~> find(ovr(mtSt, save(save(mtSt, $nonce, 5), $balances 1, 11)),
***         $nonce)
***  ~> find(save(save(mtSt, $nonce, 5), $balances 1, 11), $nonce)
***  ~> find(save(mtSt, $nonce, 5), $nonce)
***  ~> 5
*** the same read in the flagged model: eleven arrows, and all three extra ones
*** are in the sub-read. The target's old value there is not mtSt but the
*** DECLARED slot save(mtSt, $balances, mapOf(0)), so the passthrough has to
*** rebuild it through the prefix rule before v->st can cast it. The dispatch is
*** then the `prm := find(nd, f)` guard rather than a field's sort, and lands on
*** the same 5.
red in PAPER-FIND-FLAGGED : findSteps('PAPER-CMP-FLAGGED, find(s3, $ledger2 $nonce)) .
*** find(s3, $ledger2 $nonce)
***  ~> find(ovr(v→st(find(save(save(save(save(mtSt, $ledger $balances,
***         mapOf(0)), $ledger2 $balances, mapOf(0)), $ledger $nonce, 5),
***         $ledger $balances 1, 11), $ledger2)), save(save(save(mtSt,
***         $balances, mapOf(0)), $nonce, 5), $balances 1, 11)), $nonce)
***  ~> find(ovr(v→st(find(save(save(save(mtSt, $ledger $balances,
***         mapOf(0)), $ledger2 $balances, mapOf(0)), $ledger $nonce, 5),
***         $ledger2)), save(save(save(mtSt, $balances, mapOf(0)), $nonce,
***         5), $balances 1, 11)), $nonce)
***  ~> find(ovr(v→st(find(save(save(mtSt, $ledger $balances, mapOf(0)),
***         $ledger2 $balances, mapOf(0)), $ledger2)),
***         save(save(save(mtSt, $balances, mapOf(0)), $nonce, 5),
***         $balances 1, 11)), $nonce)
***  ~> find(ovr(v→st(save(v→st(find(save(mtSt, $ledger $balances,
***         mapOf(0)), $ledger2)), $balances, mapOf(0))),
***         save(save(save(mtSt, $balances, mapOf(0)), $nonce, 5),
***         $balances 1, 11)), $nonce)
***  ~> find(ovr(v→st(save(v→st(find(mtSt, $ledger2)), $balances,
***         mapOf(0))), save(save(save(mtSt, $balances, mapOf(0)), $nonce,
***         5), $balances 1, 11)), $nonce)
***  ~> find(ovr(v→st(save(v→st(0), $balances, mapOf(0))),
***         save(save(save(mtSt, $balances, mapOf(0)), $nonce, 5),
***         $balances 1, 11)), $nonce)
***  ~> find(ovr(v→st(save(mtSt, $balances, mapOf(0))),
***         save(save(save(mtSt, $balances, mapOf(0)), $nonce, 5),
***         $balances 1, 11)), $nonce)
***  ~> find(ovr(save(mtSt, $balances, mapOf(0)), save(save(save(mtSt,
***         $balances, mapOf(0)), $nonce, 5), $balances 1, 11)), $nonce)
***  ~> find(save(save(save(mtSt, $balances, mapOf(0)), $nonce, 5),
***         $balances 1, 11), $nonce)
***  ~> find(save(save(mtSt, $balances, mapOf(0)), $nonce, 5), $nonce)
***  ~> 5
red in PAPER-CMP-SORTED  : find(s3, $ledger2 $nonce) .                     *** 5
red in PAPER-CMP-FLAGGED : find(s3, $ledger2 $nonce) .                     *** 5

*** ---- C2  B's fifth arrow: $balances, the MapField arm, reads LEFT --------
*** The SAME leaf, assembled by the same six arrows, dispatched the other way.
*** The target here is unset, so LEFT is mtSt in the sorted model and the bare
*** declared slot in the flagged one -- and the answer is 0. Which arm fired is
*** visible in the dispatch arrow: it keeps the WHOLE remaining path,
*** `$balances 1`, on the target side, where C1 handed `$nonce` to the source.
red in PAPER-FIND-SORTED : findSteps('PAPER-CMP-SORTED, find(s3, $ledger2 $balances 1)) .
*** find(s3, $ledger2 $balances 1)
***  ~> find(ovr(v→st(find(save(save(mtSt, $ledger $nonce, 5), $ledger
***         $balances 1, 11), $ledger2)), save(save(mtSt, $nonce, 5),
***         $balances 1, 11)), $balances 1)
***  ~> find(ovr(v→st(find(save(mtSt, $ledger $nonce, 5), $ledger2)),
***         save(save(mtSt, $nonce, 5), $balances 1, 11)), $balances 1)
***  ~> find(ovr(v→st(find(mtSt, $ledger2)), save(save(mtSt, $nonce, 5),
***         $balances 1, 11)), $balances 1)
***  ~> find(ovr(v→st(mtSt), save(save(mtSt, $nonce, 5), $balances 1,
***         11)), $balances 1)
***  ~> find(ovr(mtSt, save(save(mtSt, $nonce, 5), $balances 1, 11)),
***         $balances 1)
***  ~> find(mtSt, $balances 1)
***  ~> 0
red in PAPER-FIND-FLAGGED : findSteps('PAPER-CMP-FLAGGED, find(s3, $ledger2 $balances 1)) .
*** find(s3, $ledger2 $balances 1)
***  ~> find(ovr(v→st(find(save(save(save(save(mtSt, $ledger $balances,
***         mapOf(0)), $ledger2 $balances, mapOf(0)), $ledger $nonce, 5),
***         $ledger $balances 1, 11), $ledger2)), save(save(save(mtSt,
***         $balances, mapOf(0)), $nonce, 5), $balances 1, 11)), $balances
***         1)
***  ~> find(ovr(v→st(find(save(save(save(mtSt, $ledger $balances,
***         mapOf(0)), $ledger2 $balances, mapOf(0)), $ledger $nonce, 5),
***         $ledger2)), save(save(save(mtSt, $balances, mapOf(0)), $nonce,
***         5), $balances 1, 11)), $balances 1)
***  ~> find(ovr(v→st(find(save(save(mtSt, $ledger $balances, mapOf(0)),
***         $ledger2 $balances, mapOf(0)), $ledger2)),
***         save(save(save(mtSt, $balances, mapOf(0)), $nonce, 5),
***         $balances 1, 11)), $balances 1)
***  ~> find(ovr(v→st(save(v→st(find(save(mtSt, $ledger $balances,
***         mapOf(0)), $ledger2)), $balances, mapOf(0))),
***         save(save(save(mtSt, $balances, mapOf(0)), $nonce, 5),
***         $balances 1, 11)), $balances 1)
***  ~> find(ovr(v→st(save(v→st(find(mtSt, $ledger2)), $balances,
***         mapOf(0))), save(save(save(mtSt, $balances, mapOf(0)), $nonce,
***         5), $balances 1, 11)), $balances 1)
***  ~> find(ovr(v→st(save(v→st(0), $balances, mapOf(0))),
***         save(save(save(mtSt, $balances, mapOf(0)), $nonce, 5),
***         $balances 1, 11)), $balances 1)
***  ~> find(ovr(v→st(save(mtSt, $balances, mapOf(0))),
***         save(save(save(mtSt, $balances, mapOf(0)), $nonce, 5),
***         $balances 1, 11)), $balances 1)
***  ~> find(ovr(save(mtSt, $balances, mapOf(0)), save(save(save(mtSt,
***         $balances, mapOf(0)), $nonce, 5), $balances 1, 11)), $balances
***         1)
***  ~> find(save(mtSt, $balances, mapOf(0)), $balances 1)
***  ~> find(mapOf(0), 1)
***  ~> 0
*** the flagged model takes one arrow more at the END as well: its unset key is
*** the declared slot's template, find(mapOf(0), 1), not a zero-init default
*** read off a field's sort.
red in PAPER-CMP-SORTED  : find(s3, $ledger2 $balances 1) .                *** 0
red in PAPER-CMP-FLAGGED : find(s3, $ledger2 $balances 1) .                *** 0

*** ---- C3  the same arm with the target written: 77, not 11 ----------------
*** Block E's storage. Now LEFT is non-empty and the answer distinguishes the
*** two sides outright: the source has 11 at that key and the read returns the
*** target's 77. The extra arrows against C2 are all in the sub-read again --
*** the target's old value is now save(mtSt, $balances 1, 77) rather than mtSt,
*** so the passthrough must rebuild it through the prefix rule before the leaf
*** can dispatch. That rebuild IS the mechanism by which a value written to the
*** target BEFORE the copy survives it.
red in PAPER-FIND-SORTED : findSteps('PAPER-CMP-SORTED, find(s3w, $ledger2 $balances 1)) .
*** find(s3w, $ledger2 $balances 1)
***  ~> find(ovr(v→st(find(save(save(save(mtSt, $ledger $nonce, 5),
***         $ledger $balances 1, 11), $ledger2 $balances 1, 77),
***         $ledger2)), save(save(mtSt, $nonce, 5), $balances 1, 11)),
***         $balances 1)
***  ~> find(ovr(v→st(save(v→st(find(save(save(mtSt, $ledger $nonce, 5),
***         $ledger $balances 1, 11), $ledger2)), $balances 1, 77)),
***         save(save(mtSt, $nonce, 5), $balances 1, 11)), $balances 1)
***  ~> find(ovr(v→st(save(v→st(find(save(mtSt, $ledger $nonce, 5),
***         $ledger2)), $balances 1, 77)), save(save(mtSt, $nonce, 5),
***         $balances 1, 11)), $balances 1)
***  ~> find(ovr(v→st(save(v→st(find(mtSt, $ledger2)), $balances 1, 77)),
***         save(save(mtSt, $nonce, 5), $balances 1, 11)), $balances 1)
***  ~> find(ovr(v→st(save(v→st(mtSt), $balances 1, 77)), save(save(mtSt,
***         $nonce, 5), $balances 1, 11)), $balances 1)
***  ~> find(ovr(v→st(save(mtSt, $balances 1, 77)), save(save(mtSt,
***         $nonce, 5), $balances 1, 11)), $balances 1)
***  ~> find(ovr(save(mtSt, $balances 1, 77), save(save(mtSt, $nonce, 5),
***         $balances 1, 11)), $balances 1)
***  ~> find(save(mtSt, $balances 1, 77), $balances 1)
***  ~> 77
red in PAPER-FIND-FLAGGED : findSteps('PAPER-CMP-FLAGGED, find(s3w, $ledger2 $balances 1)) .
*** find(s3w, $ledger2 $balances 1)
***  ~> find(ovr(v→st(find(save(save(save(save(save(mtSt, $ledger
***         $balances, mapOf(0)), $ledger2 $balances, mapOf(0)), $ledger
***         $nonce, 5), $ledger $balances 1, 11), $ledger2 $balances 1,
***         77), $ledger2)), save(save(save(mtSt, $balances, mapOf(0)),
***         $nonce, 5), $balances 1, 11)), $balances 1)
***  ~> find(ovr(v→st(save(v→st(find(save(save(save(save(mtSt, $ledger
***         $balances, mapOf(0)), $ledger2 $balances, mapOf(0)), $ledger
***         $nonce, 5), $ledger $balances 1, 11), $ledger2)), $balances 1,
***         77)), save(save(save(mtSt, $balances, mapOf(0)), $nonce, 5),
***         $balances 1, 11)), $balances 1)
***  ~> find(ovr(v→st(save(v→st(find(save(save(save(mtSt, $ledger
***         $balances, mapOf(0)), $ledger2 $balances, mapOf(0)), $ledger
***         $nonce, 5), $ledger2)), $balances 1, 77)),
***         save(save(save(mtSt, $balances, mapOf(0)), $nonce, 5),
***         $balances 1, 11)), $balances 1)
***  ~> find(ovr(v→st(save(v→st(find(save(save(mtSt, $ledger $balances,
***         mapOf(0)), $ledger2 $balances, mapOf(0)), $ledger2)),
***         $balances 1, 77)), save(save(save(mtSt, $balances, mapOf(0)),
***         $nonce, 5), $balances 1, 11)), $balances 1)
***  ~> find(ovr(v→st(save(v→st(save(v→st(find(save(mtSt, $ledger
***         $balances, mapOf(0)), $ledger2)), $balances, mapOf(0))),
***         $balances 1, 77)), save(save(save(mtSt, $balances, mapOf(0)),
***         $nonce, 5), $balances 1, 11)), $balances 1)
***  ~> find(ovr(v→st(save(v→st(save(v→st(find(mtSt, $ledger2)),
***         $balances, mapOf(0))), $balances 1, 77)), save(save(save(mtSt,
***         $balances, mapOf(0)), $nonce, 5), $balances 1, 11)), $balances
***         1)
***  ~> find(ovr(v→st(save(v→st(save(v→st(0), $balances, mapOf(0))),
***         $balances 1, 77)), save(save(save(mtSt, $balances, mapOf(0)),
***         $nonce, 5), $balances 1, 11)), $balances 1)
***  ~> find(ovr(v→st(save(v→st(save(mtSt, $balances, mapOf(0))),
***         $balances 1, 77)), save(save(save(mtSt, $balances, mapOf(0)),
***         $nonce, 5), $balances 1, 11)), $balances 1)
***  ~> find(ovr(v→st(save(save(mtSt, $balances, mapOf(0)), $balances 1,
***         77)), save(save(save(mtSt, $balances, mapOf(0)), $nonce, 5),
***         $balances 1, 11)), $balances 1)
***  ~> find(ovr(save(save(mtSt, $balances, mapOf(0)), $balances 1, 77),
***         save(save(save(mtSt, $balances, mapOf(0)), $nonce, 5),
***         $balances 1, 11)), $balances 1)
***  ~> find(save(save(mtSt, $balances, mapOf(0)), $balances 1, 77),
***         $balances 1)
***  ~> 77
red in PAPER-CMP-SORTED  : find(s3w, $ledger2 $balances 1) .               *** 77
red in PAPER-CMP-FLAGGED : find(s3w, $ledger2 $balances 1) .               *** 77

*** ---- D  a key the target never wrote -------------------------------------
*** The target has NOTHING at key 2 and the source has 22. If the copy merged
*** mappings, or copied them, 'z would be 22. It is 0: the mapping member is
*** read from the target, and the target's key 2 is unset.
red in PAPER-COPY-STEPS :
run(< $ledger . $nonce = # 5 ;
      $ledger . $balances [ # 2 ] = # 22 ;
      $ledger2 = $ledger ;
      var 'z = $ledger2 . $balances [ # 2 ] ; >) .
*** {storage := save(save(save(mtSt, $ledger $nonce, 5), $ledger $balances 2,
*** 22), $ledger2, save(save(mtSt, $nonce, 5), $balances 2, 22)) || 'z := 0}
red in PAPER-COPY-STEPS :
< $ledger . $nonce = # 5 ; $ledger . $balances [ # 2 ] = # 22 ;
  $ledger2 = $ledger ; >
    ($ledger2 . $nonce == # 5 && $ledger2 . $balances [ # 2 ] == # 0) .
                                                           *** true   base: false

*** ---- E  the leaf, printed -------------------------------------------------
*** The one statement-level block that writes the TARGET's own mapping entry, so
*** the leaf has a non-empty left side and 77 is a value only the target could
*** supply. C3 is this storage, stepped.
*** Reading $ledger2 WHOLE -- as the right-hand side of a further copy -- hits
*** the leaf rule with an empty remainder, so the value of $ledger2 is the
*** irreducible ovr(target-old, source). This is the one place in the sem/
*** suite where ovr(...) appears inside a rendered goal; everywhere else a
*** read consumes it. Writing that ovr into $alice . $ledger then keeps
*** ALICE's mapping, which is empty, so 'b := 0 -- while $ledger2's own entry
*** is still 77. Two different readers, two different answers, one value.
red in PAPER-COPY-STEPS :
run(< $ledger . $nonce = # 5 ; $ledger . $balances [ # 1 ] = # 11 ;
      $ledger2 . $balances [ # 1 ] = # 77 ;
      $ledger2 = $ledger ;
      $alice . $ledger = $ledger2 ;
      var 'n = $alice . $ledger . $nonce ;
      var 'b = $alice . $ledger . $balances [ # 1 ] ; >) .
*** {storage := save(save(save(save(save(mtSt, $ledger $nonce, 5), $ledger
*** $balances 1, 11), $ledger2 $balances 1, 77), $ledger2, save(save(mtSt,
*** $nonce, 5), $balances 1, 11)), $alice $ledger, ovr(save(mtSt, $balances 1,
*** 77), save(save(mtSt, $nonce, 5), $balances 1, 11))) || 'b := 0 || 'n := 5}
red in PAPER-COPY-STEPS :
< $ledger . $nonce = # 5 ; $ledger . $balances [ # 1 ] = # 11 ;
  $ledger2 . $balances [ # 1 ] = # 77 ;
  $ledger2 = $ledger ;
  $alice . $ledger = $ledger2 ; >
    ($alice . $ledger . $nonce == # 5
     && $alice . $ledger . $balances [ # 1 ] == # 0
     && $ledger2 . $balances [ # 1 ] == # 77) .            *** true   base: false

*** ---- F  one level down: the RefField equation ------------------------------
*** alice = bob copies a whole Person. $ledger is a RefField inside it, so the
*** leaf does not answer directly: it rebuilds one level down as
*** ovr(alice's ledger, bob's ledger), and the split applies again there. The
*** primitive $age and $nonce come from bob; $balances[1] stays alice's 77.
red in PAPER-COPY-STEPS :
run(< $alice . $ledger . $balances [ # 1 ] = # 77 ;
      $bob . $ledger . $balances [ # 1 ] = # 11 ;
      $bob . $ledger . $nonce = # 5 ;
      $bob . $age = # 4 ;
      $alice = $bob ;
      var 'g = $alice . $age ;
      var 'n = $alice . $ledger . $nonce ;
      var 'b = $alice . $ledger . $balances [ # 1 ] ; >) .
*** {storage := save(save(save(save(save(mtSt, $alice $ledger $balances 1, 77),
*** $bob $ledger $balances 1, 11), $bob $ledger $nonce, 5), $bob $age, 4),
*** $alice, save(save(save(mtSt, $ledger $balances 1, 11), $ledger $nonce, 5),
*** $age, 4)) || 'b := 77 || 'g := 4 || 'n := 5}
red in PAPER-COPY-STEPS :
< $alice . $ledger . $balances [ # 1 ] = # 77 ;
  $bob . $ledger . $balances [ # 1 ] = # 11 ;
  $bob . $ledger . $nonce = # 5 ; $bob . $age = # 4 ;
  $alice = $bob ; >
    ($alice . $age == # 4 && $alice . $ledger . $nonce == # 5
     && $alice . $ledger . $balances [ # 1 ] == # 77) .    *** true   base: false

*** ---- it is still a value copy ---------------------------------------------
*** Nothing above makes the target an alias: a later write to the source does
*** not reach it. Only the MAPPING members are shared-by-not-being-copied.
red in PAPER-COPY-STEPS :
< $ledger . $nonce = # 5 ; $ledger2 = $ledger ; $ledger . $nonce = # 9 ; >
    ($ledger2 . $nonce == # 5) .                                           *** true
