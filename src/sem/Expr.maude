*** src/sem/Expr.maude — Phase 1 of PLAN.md
***
*** Big-step expression evaluation over the configuration cells, mirroring
*** SolKey's Tier-1 operator taclets (solkey docs/taclets-implementation.md):
***  - unbounded ints, no overflow branch (Solidity Light);
***  - `/` and `%` produce `rev` on a zero denominator (the calculus'
***    revert branch) and `rev` propagates strictly through every operator;
***  - `&&` / `||` genuinely short-circuit — the right operand is passed
***    unevaluated and only touched when needed. SolKey defers this to its
***    Tier-3 `if` rule; here it falls out of the equational order;
***  - bools are Ints 0/1 (see Syntax.maude).
***
*** Lvalues lower to locations first (SolKey's `\sameAsTerm` path lowering):
***   sloc(path)      — storage, a List{Field} from the root
***   mloc(id, path)  — memory, base Identity + field path
***   vloc(q)         — a value local in the environment
*** A storage-alias local lowers straight to sloc of its bound path; index
*** expressions are evaluated to Int fields during lowering. SolKey's
*** complex-receiver unfold rules are mirrored one level up, in Order.maude:
*** by the time lower runs, that pass has already pinned every impure index
*** into a temp, so what reaches here is always side-effect-free.

load Config .

fmod SOL-EVAL{Field :: TRIV} is
    pr SOL-CONFIG{Field} .

    sorts Loc Loc? .
    subsort Loc < Loc? .
    op sloc : NeList{Field} -> Loc [ctor] .
    op mloc : Identity NeList{Field} -> Loc [ctor] .
    op vloc : Qid -> Loc [ctor] .
    op revL : -> Loc? [ctor] .

    var C : Cells .    var EV : Env .     var M : Memory .    var ST : Struct .
    var Q : Qid .      var LV : LValue .  vars E E1 E2 : Exp .
    vars P1 P2 : Prop .
    var V : Value .    vars W W1 W2 : Value? .
    vars I I1 I2 : Int .                  var ID : Identity .
    var PF : PrimField .  var IDF : RefField .  var MF : MapField .
    var F0 : Field$Elt .  var FXS : NeList{Field} .  var LFXS : List{Field} .
    var L? : Loc? .       vars SND VAL : Int .

    *** ---- lvalue lowering --------------------------------------------------
    op lower : LValue Cells -> Loc? .
    op lowB : Qid Binding -> Loc? .
    op ext : Loc? Field$Elt Cells -> Loc? .
    op extB : Binding Field$Elt -> Loc? .
    op extI : Loc? Value? Cells -> Loc? .

    eq lower(Q, env(EV) C) = lowB(Q, envR(EV, Q)) .
    eq lowB(Q, bv(V)) = vloc(Q) .
    eq lowB(Q, bp(FXS)) = sloc(FXS) .

    eq lower(LV . F0, C) = ext(lower(LV, C), F0, C) .
    eq lower(LV [ E ], C) = extI(lower(LV, C), eval(E, C), C) .

    eq ext(sloc(FXS), F0, C) = sloc(FXS F0) .
    eq ext(mloc(ID, FXS), F0, C) = mloc(ID, FXS F0) .
    eq ext(vloc(Q), F0, env(EV) C) = extB(envR(EV, Q), F0) .
    eq ext(revL, F0, C) = revL .
    eq extB(bv(ID), F0) = mloc(ID, F0) .   *** member access on a memory reference

    *** ---- array bounds ----------------------------------------------------
    *** SolKey carries a two-goal split on every storage array index rule:
    ***   0 <= ie & ie < find<[int]>(storage, sp·size)  -- else  revert();
    *** Mapping index rules carry no such branch. extI is the one place an
    *** index becomes a path component, so guarding here covers reads, writes,
    *** delete, and push/pop/alias receivers alike.
    ***
    *** ARRAY vs MAPPING is decided from the declared sort of the container
    *** field -- SolKey stamps the same distinction at parse time. The
    *** element-kind refinements come for free: RefArrField < RefField and
    *** RefMapField < MapField. An Int-keyed step inherits its container's
    *** kind, so matrix[i][j] checks both levels.
    *** Known imprecision: a mapping(uint => uint[]) is stamped RefMapField, so
    *** its INNER array index goes unchecked. No SolKey example has that shape.
    op bounded : List{Field} -> Bool .
    eq bounded(LFXS IDF) = true .
    eq bounded(LFXS MF)  = false .
    eq bounded(LFXS PF)  = false .
    eq bounded(LFXS I)   = bounded(LFXS) .
    eq bounded(nil)      = false .

    op chkB : List{Field} Cells -> Bool .
    eq chkB(LFXS, nochk C) = false .
    eq chkB(LFXS, C) = bounded(LFXS) [owise] .

    *** Two complementary conditions, no owise. The `:=` on an Int variable
    *** also means a non-numeral length simply does not match, leaving the
    *** term visibly stuck rather than silently passing the guard.
    op idxS : Bool NeList{Field} Int Cells -> Loc? .
    eq  idxS(false, FXS, I, C) = sloc(FXS I) .
    ceq idxS(true, FXS, I, sto(ST) C) = sloc(FXS I)
        if I1 := find(ST, FXS length) /\ 0 <= I /\ I < I1 .
    ceq idxS(true, FXS, I, sto(ST) C) = revL
        if I1 := find(ST, FXS length) /\ (I < 0 or I >= I1) .

    eq extI(sloc(FXS), I, C) = idxS(chkB(FXS, C), FXS, I, C) .
    *** memory arrays: SolKey bounds these too, against
    *** read<[int]>(memory, mp, size). The length is written once, at
    *** allocation (`memory q = new(n) ;`), since memory arrays never grow.
    *** An unsized memory object -- a struct -- has no length slot, so the
    *** guard must not fire for it; boundedM reads the declared kind the same
    *** way bounded does, and a struct FIELD path is never Int-keyed.
    op idxM : Bool Identity NeList{Field} Int Cells -> Loc? .
    eq  idxM(false, ID, FXS, I, C) = mloc(ID, FXS I) .
    ceq idxM(true, ID, FXS, I, mem(M) C) = mloc(ID, FXS I)
        if I1 := mread(M, ID, FXS length) /\ 0 <= I /\ I < I1 .
    ceq idxM(true, ID, FXS, I, mem(M) C) = revL
        if I1 := mread(M, ID, FXS length) /\ (I < 0 or I >= I1) .
    eq extI(mloc(ID, FXS), I, C) = idxM(chkB(FXS, C), ID, FXS, I, C) .
    *** a bare memory local holding an ARRAY identity: the array IS the root
    *** object, so there is no field prefix and the length lives at the root.
    *** Routing this through ext/extB (the plain member-access path) would skip
    *** the guard entirely, so indexing re-dispatches on the binding here.
    eq extI(vloc(Q), I, env(EV) C) = extIB(envR(EV, Q), I, env(EV) C) .
    op extIB : Binding Value? Cells -> Loc? .
    eq extIB(bv(ID), I, C) = idxM0(ID, I, C) .
    eq extIB(bp(FXS), I, C) = idxS(chkB(FXS, C), FXS, I, C) .
    eq extIB(bv(I2), I, C) = revL .   *** indexing a primitive local

    op idxM0 : Identity Int Cells -> Loc? .
    ceq idxM0(ID, I, mem(M) C) = mloc(ID, I)
        if I1 := read(M, ID, length) /\ 0 <= I /\ I < I1 .
    ceq idxM0(ID, I, mem(M) C) = revL
        if I1 := read(M, ID, length) /\ (I < 0 or I >= I1) .
    eq extI(revL, I, C) = revL .
    eq extI(L?, rev, C) = revL .           *** index expression reverted

    *** ---- location read ------------------------------------------------------
    op readLoc : Loc? Cells -> Value? .
    eq readLoc(sloc(FXS), sto(ST) C) = find(ST, FXS) .
    eq readLoc(mloc(ID, FXS), mem(M) C) = mread(M, ID, FXS) .
    eq readLoc(vloc(Q), env(EV) C) = bval(envR(EV, Q)) .
    eq readLoc(revL, C) = rev .

    *** ---- evaluation ---------------------------------------------------------
    op eval : Exp Cells -> Value? .

    eq eval(# V, C) = V .
    eq eval(LV, C) = readLoc(lower(LV, C), C) .
    eq eval(msg·sender, msg(SND, VAL) C) = SND .
    eq eval(msg·value, msg(SND, VAL) C) = VAL .
    eq eval(net[E1], C) = readNet(eval(E1, C), C) .

    op readNet : Value? Cells -> Value? .
    eq readNet(I1, net(ST) C) = find(ST, I1) .   *** net(a) = find(ledger, a); 0 on an untouched address
    eq readNet(rev, C) = rev .

    eq eval(E1 + E2, C) = add?(eval(E1, C), eval(E2, C)) .
    eq eval(E1 - E2, C) = sub?(eval(E1, C), eval(E2, C)) .
    eq eval(E1 * E2, C) = mul?(eval(E1, C), eval(E2, C)) .
    eq eval(E1 / E2, C) = div?(eval(E1, C), eval(E2, C)) .
    eq eval(E1 % E2, C) = mod?(eval(E1, C), eval(E2, C)) .
    eq eval(E1 ** E2, C) = pow?(eval(E1, C), eval(E2, C)) .
    eq eval(neg E1, C) = neg?(eval(E1, C)) .

    *** ---- condition evaluation (Prop -> Solidity truth value 1/0/rev) --------
    *** Conditions are a separate sort (see Syntax.maude) so `< <= > >=` can
    *** use the Solidity tokens; evalP returns the EVM-style Int 1/0 (so the
    *** statement layer's guards read `=/= 0`, unchanged), or rev.
    op evalP : Prop Cells -> Value? .
    eq evalP(true, C) = 1 .
    eq evalP(false, C) = 0 .
    eq evalP(E1 < E2, C) = lt?(eval(E1, C), eval(E2, C)) .
    eq evalP(E1 <= E2, C) = leq?(eval(E1, C), eval(E2, C)) .
    eq evalP(E1 > E2, C) = lt?(eval(E2, C), eval(E1, C)) .
    eq evalP(E1 >= E2, C) = leq?(eval(E2, C), eval(E1, C)) .
    eq evalP(E1 == E2, C) = eqV?(eval(E1, C), eval(E2, C)) .
    eq evalP(E1 != E2, C) = neqV?(eval(E1, C), eval(E2, C)) .
    eq evalP(P1 && P2, C) = and?(evalP(P1, C), P2, C) .
    eq evalP(P1 || P2, C) = or?(evalP(P1, C), P2, C) .
    eq evalP(! P1, C) = not?(evalP(P1, C)) .

    *** ---- strict helpers (rev propagates) --------------------------------------
    ops add? sub? mul? div? mod? pow? lt? leq? eqV? neqV? : Value? Value? -> Value? .
    op neg? : Value? -> Value? .
    op not? : Value? -> Value? .
    op and? : Value? Prop Cells -> Value? .
    op or? : Value? Prop Cells -> Value? .
    op tv : Bool -> Int .

    eq tv(true) = 1 .
    eq tv(false) = 0 .

    eq add?(I1, I2) = I1 + I2 .
    eq add?(rev, W) = rev .    eq add?(W, rev) = rev .
    eq sub?(I1, I2) = _-_(I1, I2) .    *** prefix form: `I1 - I2` also parses as the list `I1 (- I2)`
    eq sub?(rev, W) = rev .    eq sub?(W, rev) = rev .
    eq mul?(I1, I2) = I1 * I2 .
    eq mul?(rev, W) = rev .    eq mul?(W, rev) = rev .

    ceq div?(I1, I2) = I1 quo I2 if I2 =/= 0 .    *** Solidity `/` truncates toward zero, like quo
    eq div?(I1, 0) = rev .                        *** the SolKey zero-denominator revert branch
    eq div?(rev, W) = rev .    eq div?(W, rev) = rev .
    ceq mod?(I1, I2) = I1 rem I2 if I2 =/= 0 .    *** sign of the dividend, like Solidity `%`
    eq mod?(I1, 0) = rev .
    eq mod?(rev, W) = rev .    eq mod?(W, rev) = rev .
    ceq pow?(I1, I2) = I1 ^ I2 if I2 >= 0 .
    ceq pow?(I1, I2) = rev if I2 < 0 .            *** cannot arise from uint programs
    eq pow?(rev, W) = rev .    eq pow?(W, rev) = rev .
    eq neg?(I1) = - I1 .
    eq neg?(rev) = rev .

    eq lt?(I1, I2) = tv(I1 < I2) .
    eq lt?(rev, W) = rev .     eq lt?(W, rev) = rev .
    eq leq?(I1, I2) = tv(I1 <= I2) .
    eq leq?(rev, W) = rev .    eq leq?(W, rev) = rev .

    *** `===` compares evaluated values; on fully concrete values this is
    *** Solidity equality, on symbolic ones it is syntactic — a caveat shared
    *** with any normal-form-based equality.
    eq eqV?(V, V) = 1 .
    ceq eqV?(W1, W2) = 0 if W1 =/= W2 /\ W1 =/= rev /\ W2 =/= rev .
    eq eqV?(rev, W) = rev .    eq eqV?(W, rev) = rev .
    eq neqV?(V, V) = 0 .
    ceq neqV?(W1, W2) = 1 if W1 =/= W2 /\ W1 =/= rev /\ W2 =/= rev .
    eq neqV?(rev, W) = rev .   eq neqV?(W, rev) = rev .

    eq and?(0, P2, C) = 0 .                       *** short-circuit: P2 never evaluated
    ceq and?(I, P2, C) = evalP(P2, C) if I =/= 0 .
    eq and?(rev, P2, C) = rev .
    ceq or?(I, P2, C) = 1 if I =/= 0 .            *** short-circuit
    eq or?(0, P2, C) = evalP(P2, C) .
    eq or?(rev, P2, C) = rev .
    eq not?(0) = 1 .
    ceq not?(I) = 0 if I =/= 0 .
    eq not?(rev) = rev .

    *** ---- test extractors ------------------------------------------------------
    *** eread evaluates a source expression against a (final) configuration;
    *** pread evaluates a proposition (returns 1/0/rev). Both let the trailing
    *** test blocks read storage, memory and locals through the semantics.
    op eread : Conf Exp -> Value? .
    eq eread({ C }, E1) = eval(E1, nochk C) .
    op pread : Conf Prop -> Value? .
    eq pread({ C }, P1) = evalP(P1, nochk C) .
endfm

*** ---- tests: the Tier-1 matrix ------------------------------------------------

fmod SOL-EVAL-TEST{Field :: TRIV} is
    pr SOL-EVAL{Field} .

    ops $alice $account : -> RefField .
    ops $balance $nonce : -> PrimField .
    op $m : -> MapField .

    op stT : -> Struct .
    op memT : -> Memory .
    op envT : -> Env .
    op tc : -> Cells .

    eq stT = save(save(save(mtSt, $alice $balance, 10),
                       $alice $m 3, 42),
                  $alice $account $nonce, 8) .
    eq memT = write(write(emptyMemory, idC(pid(0), nil), $account, idC(pid(1), nil)),
                    idC(pid(1), nil), $balance, 9) .
    eq envT = envW(envW(envW(mtEnv, 'x, bv(4)),
                        'a, bp($alice $account)),
                   'p, bv(idC(pid(0), nil))) .
    eq tc = sto(stT) mem(memT) env(envT) msg(77, 5) .

    *** root lvalues: Field$Elt is not a subsort of LValue (see Syntax.maude),
    *** so each field constant usable as a ROOT is overloaded at Root < LValue.
    ops $account $alice $balance $m $nonce : -> Root .
    var Clv : Cells .
    eq lower($account, Clv) = sloc($account) .
    eq lower($alice, Clv) = sloc($alice) .
    eq lower($balance, Clv) = sloc($balance) .
    eq lower($m, Clv) = sloc($m) .
    eq lower($nonce, Clv) = sloc($nonce) .
endfm

*** arithmetic
red eval('x + # 1, tc) .             *** 5
red eval('x - # 10, tc) .            *** -6
red eval('x * 'x, tc) .            *** 16
red eval(# 9 / 'x, tc) .             *** 2   (truncating)
red eval(neg # 9 / 'x, tc) .         *** -2  (toward zero, like Solidity)
red eval('x / # 0, tc) .             *** rev — the revert branch
red eval(# 7 % 'x, tc) .             *** 3
red eval('x % # 0, tc) .             *** rev
red eval(# 2 ** 'x, tc) .            *** 16
red eval(neg 'x, tc) .             *** -4
red eval(# 1 + 'x / # 0, tc) .         *** rev — strict propagation

*** relational / equality (conditions — evalP)
red evalP('x < # 4, tc) .            *** 0
red evalP('x <= # 4, tc) .           *** 1
red evalP('x > # 3, tc) .            *** 1
red evalP('x >= # 5, tc) .           *** 0
red evalP('x == # 4, tc) .           *** 1
red evalP('x != # 4, tc) .           *** 0

*** logical, incl. genuine short-circuit
red evalP(true && 'x < # 9, tc) .        *** 1
red evalP(false && # 1 / # 0 == # 0, tc) .   *** 0 — RHS never evaluated
red evalP(true || # 1 / # 0 == # 0, tc) .    *** 1 — RHS never evaluated
red evalP(false || 'x == # 4, tc) .      *** 1
red evalP(! ('x == # 4), tc) .           *** 0
red evalP(# 1 / # 0 == # 0 && true, tc) .    *** rev — LHS revert wins

*** lvalue reads: storage root/field/index, alias, memory reference
red eval($alice . $balance, tc) .        *** 10
red eval($alice . $m [ # 3 ], tc) .        *** 42
red eval($alice . $m [ 'x - # 1 ], tc) .   *** 42 — computed index
red eval('a . $nonce, tc) .              *** 8 — through the storage alias path
red eval('p . $account . $balance, tc) . *** 9 — deep memory read
red eval('x, tc) .                       *** 4 — value local
red eval($alice . $m [ # 1 / # 0 ], tc) .    *** rev — index expression reverted

*** environment
red eval(msg·sender, tc) .           *** 77
red eval(msg·value, tc) .            *** 5
