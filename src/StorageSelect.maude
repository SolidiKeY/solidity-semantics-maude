*** SIBLING NOTE: ../src/StorageCopy.maude carries SolKey's current copy and
*** delete semantics -- a struct copy keeps the TARGET's mapping members, and
*** delete is sort-directed. This file is a pure selectSt/find READ model with
*** no save and no delete, so neither delta applies to it as written. It is,
*** though, the natural home for a literal transcription of SolKey's
*** selectOnSaveEmpty* rules, which are stated selector-at-a-time exactly as
*** this model reads. Not done here.

load Fields .

fmod STORAGE{Field :: TRIV} is
    pr FIELDS{Field} .

    sort Struct .

    subsort Struct < StValue .   *** structHeader.key: Struct \extends StValue

    *** signatures mirror SolKey structRules.key: storage holds StValue
    op mtSt : -> Struct .
    op storeSt : Struct Field$Elt StValue -> Struct .
    op selectSt : Struct Field$Elt -> StValue .
    op find : Struct List{Field} -> StValue .

    var st : StValue .
    var fld : Field$Elt .
    var val : StValue .
    var flds flds2 : NeList{Field} .

    eq find(val, nil) = val .
    eq find(storeSt(st, fld, val), fld flds) = find(val, flds) .

    eq find(st, flds flds2) = find(find(st, flds), flds2) .
endfm
